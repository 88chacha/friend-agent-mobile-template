{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * -f)"
    ],
    "ask": [
      "Bash(npx eas-cli* build*)",
      "Bash(eas build*)",
      "Bash(npx eas-cli* submit*)",
      "Bash(eas submit*)",
      "Bash(git push *)"
    ]
  }
}
